{% extends 'templates/_document.twig' %}

{% block content %}
  <div class="hero-section">
      <div class="container">
      <h1 class="hero-title">
        {{ function('is_home') ? post.title : (function('single_term_title', '', false) ?: function('get_the_archive_title')) }}
      </h1>
      </div>
  </div>
  {{ renderComponent('GridPostsArchive', {posts: posts}) }}
  {% for component in post.meta('pageComponents') %}
    {{ renderComponent(component) }}
  {% endfor %}
{% endblock %}
